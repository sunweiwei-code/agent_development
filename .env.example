# 复制为 .env 后填入真实值：cp .env.example .env
# 前两个是必需项，缺了服务能起、但一发消息就会报错；后面几个留空即可。

# ① 对话与抽取（DeepSeek，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选，默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# ② 查询向量（阿里云百炼 DashScope，text-embedding-v4 / 1024 维）
#    索引已随仓库提供，只有重建索引时才需要重新嵌入文档；但每次提问都要用它把问题转向量
DASHSCOPE_API_KEY=

# ③ 可选：LangSmith 追踪，不填就走本地日志
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
